# ============================================================================ #
# Makemyno — live configuration.
#
# install.sh copies this to .env and generates WORKER_SECRET. The file is in
# .gitignore and chmod 600, so it never reaches the repository.
#
# Only the values in the first block usually need changing. Everything below it
# has a working default and is documented in config.py with the reason it exists.
# ============================================================================ #

# ---- identity -------------------------------------------------------------- #
# NOTE: there is deliberately no MODE line here.
#
# The role is passed to main.py as an argument (`main.py owner`), because systemd
# reads EnvironmentFile= AFTER Environment= and lets the file win. A `MODE=owner`
# line in this shared file therefore overrode the per-service role and started the
# owner bot twice — two dashboards for one /start, and a customer bot that never
# ran at all. Do not add MODE back.

API_ID=2040
API_HASH=b18441a1ff607e10a989891a5462e627

# The owner panel — only you ever talk to this one.
OWNER_BOT_TOKEN=8807317155:AAHhUlYy30m4m-6gcxQb4YpbCcxdxsaNx6I
# The bot your customers use.
CUSTOMER_BOT_TOKEN=8392186467:AAF4R29w10kNJeMUg62yr2HWYdKcO8yC4mQ

OWNER_ID=5818420346

# The PRIVATE log group. BOTH bots must be members with permission to post.
# Never named anywhere in the customer-facing UI — a test enforces that only
# config.py and logbus.py may reference it.
LOG_GROUP_ID=-1003705340609

# Generated by install.sh. Encrypts worker credentials, portable session tokens
# and backups. KEEP A COPY: lose it and old backups can never be opened again.
WORKER_SECRET=

# ---- worker fleet ---------------------------------------------------------- #
# MUST point at THIS repository. Pointing it at an older repo makes the owner
# panel's "update all workers" silently downgrade the whole fleet.
GIT_REPO_URL=https://github.com/shootingv818/Makemyno
GIT_BRANCH=feat/multi-tenant-foundation
WORKER_API_PORT=8765
WORKER_BIND_HOST=0.0.0.0
# Set only on a worker machine; the owner panel generates one per worker.
WORKER_API_TOKEN=
# Should this master machine also do sending work itself?
MASTER_AS_WORKER=true

# ---- subscription (no payments — you grant time by hand) ------------------- #
TRIAL_DAYS=3
EXPIRY_WARN_DAYS=2

# ---- anti-abuse ------------------------------------------------------------ #
RATE_LIMIT_MAX=35
RATE_LIMIT_WINDOW=120
RATE_LIMIT_AUTOBLOCK=true

# More than START_FLOOD_MAX distinct NEW users pressing /start inside
# START_FLOOD_WINDOW seconds takes the customer bot offline until you lift it
# from the owner panel.
START_FLOOD_MAX=20
START_FLOOD_WINDOW=120
START_FLOOD_SHIELD=true

# ---- session safety (the most important correctness rule in the project) --- #
# Rubika allows ONE live connection per session. Reopening too soon after a
# close is treated as a conflict and revokes the session, so we always wait.
SESSION_SETTLE_SEC=5
BUSY_STALE_SEC=7200

# ---- Rubika sending -------------------------------------------------------- #
SEND_DELAY=1.0
FORWARD_MARKER=کد135
MAX_ERRORS=5
SEND_TIMEOUT=60
SEND_LOG_EVERY=50
RESUME_WAIT=300
RESUME_UNLIMITED=true

# ---- contacts / number building -------------------------------------------- #
CONTACT_ADD_DELAY=1.0
CONTACT_IMPORT_MAX=20000
BRAIN_MAX_NUMBERS=20000
DISCOVERY_TARGET=150
DISCOVERY_PROBE_DELAY=0.7
# Daily probe budget PER CUSTOMER, shared by discovery + brain + pool. This is
# the real throttle on number building; the pool spends it faster, not more.
PROBE_DAILY_CAP=2000

# ---- pool brain ------------------------------------------------------------ #
POOL_BLOCK=50
POOL_MAX_TARGET=20000

# ---- PV photo archive -> PDF ----------------------------------------------- #
PV_EXPORT_MAX_PHOTOS=2000
PV_EXPORT_MAX_CONCURRENT=1
PV_EXPORT_PDF_BATCH=100
PV_EXPORT_PDF_QUALITY=45
PV_EXPORT_PDF_MAX_EDGE=1000
# auto | parallel | safe
PV_EXPORT_MODE_DEFAULT=auto
PV_EXPORT_PARALLEL=4
PV_EXPORT_PARALLEL_MAX=8

# ---- tabchi + secretary ---------------------------------------------------- #
TABCHI_DEFAULT_INTERVAL=1800
TABCHI_ACCOUNT_STAGGER=30
GROUP_JOIN_DELAY=3
SECRETARY_INTERVAL=600

# ---- health engine --------------------------------------------------------- #
HEALTH_ENGINE_ENABLED=true
HEALTH_ENGINE_INTERVAL=10800
HEALTH_ENGINE_WARMUP=300
NOTIFY_CUSTOMER_ON_DEAD=true
DEAD_BURST_MAX=10
DEAD_BURST_WINDOW=3600

# ---- backup (owner only, sessions only, encrypted) ------------------------- #
BACKUP_INTERVAL=43200

# ---- misc ------------------------------------------------------------------ #
TIMEZONE=Asia/Tehran
VERSION=V1
# Shown on the customer support button. Leave empty to hide it.
SUPPORT_URL=
