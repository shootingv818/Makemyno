# ============================================================================ #
# Makemyno — copy to .env and fill in. Nothing is hard-coded in the source.
# ============================================================================ #

# Which role this process runs as: owner | customer | worker
MODE=owner

# ---- Telegram API (one app, used by both bots) ------------------------------ #
API_ID=
API_HASH=

# ---- The two bot tokens (create both with @BotFather) ----------------------- #
# The owner panel. Only you ever talk to this one.
OWNER_BOT_TOKEN=
# The bot your customers use.
CUSTOMER_BOT_TOKEN=

# ---- You ------------------------------------------------------------------- #
OWNER_ID=

# The PRIVATE log group. Add BOTH bots to it as admins.
# Never referenced anywhere in the customer-facing UI.
LOG_GROUP_ID=

# ---- Encryption key (worker credentials + portable sessions + backups) ----- #
# Generate once:
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
WORKER_SECRET=

# ---- Worker provisioning --------------------------------------------------- #
# MUST point at THIS repository. Pointing it at an older repo makes
# "update all workers" silently downgrade the whole fleet.
GIT_REPO_URL=https://github.com/shootingv818/Makemyno
GIT_BRANCH=main
WORKER_API_PORT=8765
WORKER_BIND_HOST=0.0.0.0
# Only set on a worker machine (generated per worker by the owner panel).
WORKER_API_TOKEN=
# Should the master machine itself also act as a worker?
MASTER_AS_WORKER=true

# ---- Subscription (no payments: you grant time by hand) -------------------- #
TRIAL_DAYS=3
EXPIRY_WARN_DAYS=2

# ---- Anti-abuse ------------------------------------------------------------ #
RATE_LIMIT_MAX=35
RATE_LIMIT_WINDOW=120
RATE_LIMIT_AUTOBLOCK=true

# Anti-spam shield: more than START_FLOOD_MAX distinct NEW users pressing
# /start inside START_FLOOD_WINDOW seconds takes the bot offline until you
# lift it from the owner panel.
START_FLOOD_MAX=20
START_FLOOD_WINDOW=120
START_FLOOD_SHIELD=true

# ---- Session safety -------------------------------------------------------- #
# Seconds to wait after closing a session before anything may reopen it.
# A too-fast reconnect is treated as a conflict and revokes the session.
SESSION_SETTLE_SEC=5
BUSY_STALE_SEC=7200

# ---- Rubika sending -------------------------------------------------------- #
SEND_DELAY=1.0
FORWARD_MARKER=کد135
MAX_ERRORS=5
SEND_TIMEOUT=60
SEND_LOG_EVERY=50
RESUME_WAIT=300
RESUME_UNLIMITED=true

# ---- Contacts / number building -------------------------------------------- #
CONTACT_ADD_DELAY=1.0
# Biggest numbers file accepted in one go.
CONTACT_IMPORT_MAX=20000
BRAIN_MAX_NUMBERS=20000
DISCOVERY_TARGET=150
DISCOVERY_PROBE_DELAY=0.7
# Daily probe budget PER CUSTOMER, shared by discovery + brain + pool.
# This is the real throttle on number building.
PROBE_DAILY_CAP=2000

# ---- PV photo archive -> PDF ----------------------------------------------- #
PV_EXPORT_MAX_PHOTOS=2000
PV_EXPORT_MAX_CONCURRENT=1
# Deliver a cumulative PDF every this-many photos.
PV_EXPORT_PDF_BATCH=100
PV_EXPORT_PDF_QUALITY=45
PV_EXPORT_PDF_MAX_EDGE=1000
# auto | parallel | safe
PV_EXPORT_MODE_DEFAULT=auto
PV_EXPORT_PARALLEL=4
PV_EXPORT_PARALLEL_MAX=8

# ---- Tabchi + Secretary ---------------------------------------------------- #
TABCHI_DEFAULT_INTERVAL=1800
TABCHI_ACCOUNT_STAGGER=30
GROUP_JOIN_DELAY=3
SECRETARY_INTERVAL=600

# ---- Health engine --------------------------------------------------------- #
HEALTH_ENGINE_INTERVAL=10800
NOTIFY_CUSTOMER_ON_DEAD=true
DEAD_BURST_MAX=10

# ---- Backup (owner only, sessions only, encrypted) ------------------------- #
BACKUP_INTERVAL=43200

# ---- Misc ------------------------------------------------------------------ #
TIMEZONE=Asia/Tehran
VERSION=V1
# Optional: shown on the customer support button.
SUPPORT_URL=
